# Обязательно: API ключ Groq (https://console.groq.com/)
GROQ_API_KEY=gsk_...

# Опционально: модель LLM для ответов, если LLM_ANSWER_MODEL не задан
LLM_MODEL=llama-3.3-70b-versatile

# Опционально: router лучше держать на быстрой JSON-стабильной модели.
# Router намеренно не наследует LLM_MODEL по умолчанию, чтобы groq/compound не ломал latency/лимиты.
LLM_ROUTER_MODEL=llama-3.1-8b-instant
LLM_ANSWER_MODEL=llama-3.3-70b-versatile

# Опционально: лимиты компактного контекста для LLM-router.
# ROUTER_MAX_PROMPT_CHARS - safety budget backend, а не реальное context window модели.
ROUTER_CONTEXT_CHAR_LIMIT=2500
ROUTER_ASSISTANT_SNIPPET_CHAR_LIMIT=450
ROUTER_MAX_PROMPT_CHARS=4200
ROUTER_BAD_TIER_TTL_SECONDS=600

# Опционально: использовать локальные мок-данные вместо обращения к Reverb
USE_MOCK_REVERB=true

# Секрет для подписи auth token. В production заменить на длинное случайное значение.
AUTH_SECRET_KEY=change-me-local-dev-secret

# Опционально: время жизни auth token в секундах (по умолчанию 7 дней)
AUTH_TOKEN_TTL_SECONDS=604800
