GROQ_API_KEY=gsk_...

LLM_MODEL=llama-3.3-70b-versatile
LLM_ROUTER_MODEL=llama-3.1-8b-instant
LLM_ANSWER_MODEL=openai/gpt-oss-20b

ROUTER_CONTEXT_CHAR_LIMIT=2500
